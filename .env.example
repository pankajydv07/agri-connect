# ---------------------------------------------------------------------------
# AgriConnect — server environment
#
# Copy to server/.env and fill in. NEVER commit the filled-in file.
#
# The previous version of this file documented DATABASE_URL / sqlite settings
# that the application does not use, and omitted JWT_EXPIRE — whose absence
# silently caused the server to mint non-expiring auth tokens.
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/agriconnect

# Secret used to sign auth tokens. Must be at least 32 characters in
# production. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Token lifetime (zeit/ms format: 15m, 12h, 7d).
JWT_EXPIRE=7d

# bcrypt cost factor. Higher is slower and safer.
BCRYPT_ROUNDS=12

# --- CORS (required in production) -----------------------------------------

# Comma-separated list of browser origins allowed to call this API.
# Defaults to http://localhost:3000 when unset outside production.
CORS_ORIGINS=http://localhost:3000

# Public origin of this API. Used to build absolute URLs for generated files.
PUBLIC_URL=http://localhost:5000

# --- Rate limiting (optional) ----------------------------------------------

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=30

# --- Uploads (optional) ----------------------------------------------------

MAX_UPLOAD_BYTES=5242880
MAX_AUDIO_UPLOAD_BYTES=10485760

# --- Logging (optional) ----------------------------------------------------

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Integrations. Each is optional: if unset, that feature returns 503 rather
# than crashing the server. All of these are SERVER-SIDE ONLY — none may be
# exposed to the browser as a REACT_APP_* variable.
# ---------------------------------------------------------------------------

# --- Cloudinary (product image upload) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Groq (every LLM feature) ---
# Powers the in-app assistant, crop recommendation, and pest detection.
# Get a key at https://console.groq.com/keys
# Replaces the previous Nebius + OpenAI split. The Nebius token used to be a
# string literal inside server/controllers/cropController.js — never do that.
GROQ_API_KEY=

# Model ids are overridable because Groq deprecates models on short notice.
# Check https://console.groq.com/docs/models before pinning anything.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Tool-calling chat model — assistant + crop recommendation.
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Multimodal model — pest detection. Must support image input and JSON mode.
# GROQ_VISION_MODEL=qwen/qwen3.6-27b

# --- Weather ---
# None needed. Weather comes from Open-Meteo, which requires no API key and no
# attribution. Chosen deliberately so this feature adds no new secret.

# --- Google Cloud (speech-to-text and text-to-speech) ---
# Provide EITHER a path to a service-account key file …
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# … OR the key JSON inline, which is how most PaaS hosts inject secrets.
# Never commit either one to the repository.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account", ...}
