# Server Configuration
# The port on which the backend server will run
PORT=5000

# Application environment (development, production, test)
NODE_ENV=development

# Database
# MongoDB connection string (local or MongoDB Atlas)
# Format: mongodb://username:password@host:port/database or mongodb+srv://...
MONGO_URI=mongodb://localhost:27017/agri-connect

# Authentication
# Secret key for JWT token generation and verification
# Generate a strong random string for production
JWT_SECRET=your_jwt_secret_key_here

# Google Cloud Speech-to-Text
# Path to your Google Cloud service account JSON credentials file
GOOGLE_APPLICATION_CREDENTIALS=path/to/google-credentials.json
