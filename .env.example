# ==========================================
# Server Configuration
# ==========================================
# The port number on which the server will run
# Examples: 3000, 5000, 8080
PORT=5000

# Node.js environment mode
# Options: development, production, test
NODE_ENV=development

# Base URL of the application
# Used for generating links and callbacks
BASE_URL=http://localhost:5000

# ==========================================
# Google Cloud Speech Configuration
# ==========================================
# Path to the Google Cloud service account JSON key file
# Download from Google Cloud Console > IAM & Admin > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=./config/google-cloud-service-account.json

# Your Google Cloud Project ID
# Found in Google Cloud Console dashboard
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# Region for Google Cloud Speech-to-Text API
# Common regions: us-central1, us-east1, europe-west1, asia-east1
GOOGLE_CLOUD_SPEECH_REGION=us-central1

# ==========================================
# Database Configuration
# ==========================================
# Connection string or path for the database
# For SQLite (default for development): sqlite:./filename.sqlite
# For PostgreSQL: postgresql://user:password@localhost:5432/dbname
# For MySQL: mysql://user:password@localhost:3306/dbname
DATABASE_URL=sqlite:./agri-connect.sqlite

# Alternative: Specific database file path for SQLite
DB_PATH=./database.sqlite

# ==========================================
# API Configuration (Axios)
# ==========================================
# Base URL for external API calls using axios
# Example: https://api.weather-service.com/v1
EXTERNAL_API_BASE_URL=https://api.example.com/v1

# API key for external service authentication
EXTERNAL_API_KEY=your-external-api-key-here

# Additional third-party service API keys
# WEATHER_API_KEY=your-weather-api-key
# MARKET_DATA_API_KEY=your-market-data-api-key

# ==========================================
# File Upload Configuration
# ==========================================
# Directory path for storing uploaded files
# This directory is referenced in .gitignore (uploads/*)
UPLOAD_PATH=./uploads

# Maximum file size allowed for uploads (in bytes)
# 10485760 = 10MB, 52428800 = 50MB, 104857600 = 100MB
MAX_FILE_SIZE=10485760

# ==========================================
# Client-Side Environment Variables (/client)
# ==========================================
# IMPORTANT: Variables must start with REACT_APP_ to be accessible in React
# These are used by the React frontend application

# Backend API URL that the React app will communicate with
REACT_APP_API_URL=http://localhost:5000/api

# Google OAuth 2.0 Client ID for authentication
# Create at https://console.cloud.google.com/apis/credentials
REACT_APP_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Environment indicator for the frontend
# Options: development, staging, production
REACT_APP_ENVIRONMENT=development

# ==========================================
# Security Configuration
# ==========================================
# JWT (JSON Web Token) secret key for authentication
# IMPORTANT: Use a strong random string in production!
# Generate a secure key with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-immediately

# Session secret for express-session middleware
# IMPORTANT: Use a strong random string in production!
SESSION_SECRET=your-super-secret-session-key-change-this-in-production-immediately
