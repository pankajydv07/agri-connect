import os
import pytest

# Path to the test file
TEST_FILE_PATH = 'test.txt'
EXPECTED_CONTENT = 'This is a test file for AgriConnect repository.'

def test_txt_file_exists():
    """Verify that test.txt file exists in the root directory."""
    assert os.path.exists(TEST_FILE_PATH), f"File {TEST_FILE_PATH} should exist"

def test_txt_file_is_file():
    """Verify that test.txt is a file, not a directory."""
    assert os.path.isfile(TEST_FILE_PATH), f"{TEST_FILE_PATH} should be a file"

def test_txt_file_content():
    """Verify that test.txt contains the expected content."""
    with open(TEST_FILE_PATH, 'r', encoding='utf-8') as f:
        content = f.read()
    assert content == EXPECTED_CONTENT, f"File content mismatch. Expected: '{EXPECTED_CONTENT}', Got: '{content}'"

def test_txt_file_not_empty():
    """Verify that test.txt is not empty."""
    assert os.path.getsize(TEST_FILE_PATH) > 0, f"{TEST_FILE_PATH} should not be empty"

def test_txt_file_is_readable():
    """Verify that test.txt has read permissions."""
    assert os.access(TEST_FILE_PATH, os.R_OK), f"{TEST_FILE_PATH} should be readable"

def test_txt_file_no_extra_newlines():
    """Verify that test.txt does not have trailing newlines (based on patch)."""
    with open(TEST_FILE_PATH, 'r', encoding='utf-8') as f:
        content = f.read()
    assert not content.endswith('\n'), "File should not end with newline based on patch content"