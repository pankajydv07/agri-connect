import pytest
import os
import re
from pathlib import Path

class TestEnvExampleFile:
    """Tests for .env.example configuration file"""
    
    @pytest.fixture
    def env_path(self):
        """Fixture providing path to .env.example"""
        return Path('.env.example')
    
    @pytest.fixture
    def env_content(self, env_path):
        """Fixture providing content of .env.example"""
        if not env_path.exists():
            pytest.skip(".env.example file does not exist")
        return env_path.read_text(encoding='utf-8')
    
    @pytest.fixture
    def parsed_vars(self, env_content):
        """Parse environment variables from content"""
        variables = {}
        for line in env_content.splitlines():
            line = line.strip()
            if line and not line.startswith('#') and '=' in line:
                key, value = line.split('=', 1)
                variables[key.strip()] = value.strip()
        return variables

    def test_file_exists_in_root(self, env_path):
        """Test that .env.example file exists in root directory"""
        assert env_path.exists(), ".env.example should exist in repository root"
        assert env_path.is_file(), ".env.example should be a regular file"

    def test_file_is_not_empty(self, env_content):
        """Test that file has content"""
        assert len(env_content) > 0, ".env.example should not be empty"
        assert len(env_content) > 100, ".env.example should contain substantial documentation"

    def test_contains_server_configuration_section(self, env_content):
        """Test Server Configuration section exists with required variables"""
        assert "Server Configuration" in env_content, "Should have Server Configuration section"
        assert "PORT=" in env_content, "Should define PORT"
        assert "NODE_ENV=" in env_content, "Should define NODE_ENV"
        assert "BASE_URL=" in env_content, "Should define BASE_URL"

    def test_contains_google_cloud_section(self, env_content):
        """Test Google Cloud Speech configuration section"""
        assert "Google Cloud Speech" in env_content, "Should have Google Cloud Speech section"
        assert "GOOGLE_APPLICATION_CREDENTIALS=" in env_content, "Should define GOOGLE_APPLICATION_CREDENTIALS"
        assert "GOOGLE_CLOUD_PROJECT_ID=" in env_content, "Should define GOOGLE_CLOUD_PROJECT_ID"
        assert "GOOGLE_CLOUD_SPEECH_REGION=" in env_content, "Should define GOOGLE_CLOUD_SPEECH_REGION"

    def test_contains_database_section(self, env_content):
        """Test Database Configuration section"""
        assert "Database Configuration" in env_content, "Should have Database Configuration section"
        assert "DATABASE_URL=" in env_content, "Should define DATABASE_URL"

    def test_contains_security_section(self, env_content):
        """Test Security Configuration section with sensitive variables"""
        assert "Security Configuration" in env_content, "Should have Security Configuration section"
        assert "JWT_SECRET=" in env_content, "Should define JWT_SECRET"
        assert "SESSION_SECRET=" in env_content, "Should define SESSION_SECRET"
        assert "CORS_ORIGIN=" in env_content, "Should define CORS_ORIGIN"

    def test_contains_client_side_variables(self, env_content):
        """Test Client-Side Environment Variables section"""
        assert "Client-Side Environment Variables" in env_content, "Should have Client-Side section"
        assert "REACT_APP_API_URL=" in env_content, "Should define REACT_APP_API_URL"
        assert "REACT_APP_ENVIRONMENT=" in env_content, "Should define REACT_APP_ENVIRONMENT"

    def test_contains_file_upload_config(self, env_content):
        """Test File Upload Configuration section"""
        assert "File Upload Configuration" in env_content, "Should have File Upload Configuration section"
        assert "UPLOAD_PATH=" in env_content, "Should define UPLOAD_PATH"
        assert "MAX_FILE_SIZE=" in env_content, "Should define MAX_FILE_SIZE"

    def test_contains_api_configuration(self, env_content):
        """Test API Configuration section for axios"""
        assert "API Configuration" in env_content, "Should have API Configuration section"
        assert "EXTERNAL_API_BASE_URL=" in env_content, "Should define EXTERNAL_API_BASE_URL"
        assert "EXTERNAL_API_KEY=" in env_content, "Should define EXTERNAL_API_KEY"

    def test_has_descriptive_comments(self, env_content):
        """Test that variables have descriptive comments above them"""
        lines = env_content.splitlines()
        comment_count = sum(1 for line in lines if line.strip().startswith('#'))
        assert comment_count >= 20, "Should have extensive comments documenting variables"
        
        # Check for section headers (lines with === or ---)
        section_headers = [line for line in lines if '===' in line or '---' in line]
        assert len(section_headers) >= 6, "Should have section header separators"

    def test_placeholder_values_for_secrets(self, parsed_vars):
        """Test that sensitive variables use placeholder/example values"""
        sensitive_patterns = ['SECRET', 'KEY', 'PASSWORD', 'CREDENTIALS']
        
        for key, value in parsed_vars.items():
            if any(pattern in key for pattern in sensitive_patterns):
                # Should not look like a real secret (long random string)
                if len(value) > 20 and not any(x in value.lower() for x in ['your', 'example', 'change', 'placeholder', 'localhost']):
                    assert False, f"{key} should use placeholder value, not real secret"
                
                # Should contain indication it's a placeholder
                assert any(x in value.lower() for x in ['your', 'example', 'change', 'placeholder']) or \
                       'localhost' in value or 'development' in value or 'test' in value, \
                       f"{key} should indicate it needs to be changed"

    def test_valid_env_syntax(self, env_content):
        """Test that file follows standard .env syntax"""
        lines = env_content.splitlines()
        
        for i, line in enumerate(lines, 1):
            stripped = line.strip()
            
            # Skip empty lines and comments
            if not stripped or stripped.startswith('#'):
                continue
            
            # Must contain = for variable assignment
            assert '=' in line, f"Line {i} is not a valid env variable (missing =): {line}"
            
            # Extract key
            key = line.split('=', 1)[0].strip()
            
            # Key should follow standard naming convention (uppercase with underscores)
            assert re.match(r'^[A-Z][A-Z0-9_]*$', key) or \
                   re.match(r'^REACT_APP_[A-Z][A-Z0-9_]*$', key), \
                   f"Key '{key}' on line {i} should follow UPPER_SNAKE_CASE convention"

    def test_port_value_is_numeric(self, parsed_vars):
        """Test that PORT has a numeric example value"""
        if 'PORT' in parsed_vars:
            port_val = parsed_vars['PORT']
            assert port_val.isdigit(), f"PORT should have numeric example value, got: {port_val}"
            assert 1000 <= int(port_val) <= 65535, "PORT should be in valid range (1000-65535)"

    def test_node_env_valid_options(self, parsed_vars):
        """Test NODE_ENV has valid example value"""
        if 'NODE_ENV' in parsed_vars:
            valid_envs = ['development', 'production', 'test']
            env_val = parsed_vars['NODE_ENV'].lower()
            assert env_val in valid_envs, f"NODE_ENV example should be one of {valid_envs}, got: {env_val}"

    def test_upload_path_references_gitignored_directory(self, env_content):
        """Test that UPLOAD_PATH references the uploads directory mentioned in .gitignore"""
        assert "UPLOAD_PATH=" in env_content, "Should define UPLOAD_PATH"
        # Check if uploads is mentioned in the value or comments
        assert "uploads" in env_content.lower() or "upload" in env_content.lower(), \
            "Should reference uploads directory"

    def test_react_app_variables_prefixed(self, parsed_vars):
        """Test that client-side variables use REACT_APP_ prefix"""
        client_vars = [k for k in parsed_vars.keys() if any(x in k.lower() for x in ['react', 'client', 'frontend'])]
        for var in client_vars:
            if var not in ['REACT_APP_API_URL', 'REACT_APP_GOOGLE_CLIENT_ID', 'REACT_APP_ENVIRONMENT']:
                # Allow other REACT_APP_ variables
                pass
        
        # Check that non-REACT_APP variables aren't client-specific
        non_prefixed_client = [k for k in parsed_vars.keys() 
                              if any(x in k.lower() for x in ['client', 'frontend', 'react']) 
                              and not k.startswith('REACT_APP_')]
        assert len(non_prefixed_client) == 0, f"Client variables should use REACT_APP_ prefix: {non_prefixed_client}"

    def test_file_not_in_gitignore(self):
        """Test that .env.example is not ignored by .gitignore"""
        gitignore_path = Path('.gitignore')
        if not gitignore_path.exists():
            pytest.skip("No .gitignore file found")
        
        gitignore_content = gitignore_path.read_text()
        lines = gitignore_content.splitlines()
        
        for line in lines:
            stripped = line.strip()
            if stripped.startswith('#') or not stripped:
                continue
            
            # Check if .env.example would be matched
            if '.env.example' in stripped:
                assert False, f".env.example should not be in .gitignore: {line}"
            
            # Check that .env.example wouldn't match .env.* pattern
            if stripped == '.env.*' or stripped == '.env*':
                # This would ignore .env.example, which is bad
                assert False, f".gitignore pattern '{stripped}' would ignore .env.example"

