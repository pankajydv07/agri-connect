const http = require('http');
const fs = require('fs');
const path = require('path');
const yaml = require('js-yaml');
const { execSync } = require('child_process');

// Mock http module before requiring healthcheck
jest.mock('http');

describe('Docker Setup Validation', () => {
  const rootDir = path.join(__dirname, '..');
  
  describe('Dockerfile', () => {
    let dockerfile;
    
    beforeAll(() => {
      dockerfile = fs.readFileSync(path.join(rootDir, 'Dockerfile'), 'utf8');
    });

    test('uses multi-stage build with builder and production stages', () => {
      expect(dockerfile).toMatch(/FROM\s+node:.*AS\s+builder/);
      expect(dockerfile).toMatch(/FROM\s+node:.*AS\s+production/);
    });

    test('creates and uses non-root user for security', () => {
      expect(dockerfile).toContain('addgroup');
      expect(dockerfile).toContain('adduser');
      expect(dockerfile).toMatch(/USER\s+nodejs/);
    });

    test('exposes port 3000', () => {
      expect(dockerfile).toMatch(/EXPOSE\s+3000/);
    });

    test('includes healthcheck instruction', () => {
      expect(dockerfile).toMatch(/HEALTHCHECK/);
      expect(dockerfile).toContain('healthcheck.js');
    });

    test('uses npm ci for deterministic installs', () => {
      expect(dockerfile).toContain('npm ci');
    });

    test('copies package files before source for layer caching', () => {
      const lines = dockerfile.split('\n');
      const packageCopyIndex = lines.findIndex(l => l.includes('COPY package'));
      const sourceCopyIndex = lines.findIndex(l => l.includes('COPY .') && !l.includes('package'));
      expect(packageCopyIndex).toBeLessThan(sourceCopyIndex);
    });
  });

  describe('Docker Compose Configuration', () => {
    let compose;
    
    beforeAll(() => {
      const composeFile = fs.readFileSync(path.join(rootDir, 'docker-compose.yml'), 'utf8');
      compose = yaml.load(composeFile);
    });

    test('defines version 3.8', () => {
      expect(compose.version).toBe('3.8');
    });

    test('has app and db services', () => {
      expect(compose.services.app).toBeDefined();
      expect(compose.services.db).toBeDefined();
    });

    test('app service targets production stage', () => {
      expect(compose.services.app.build.target).toBe('production');
    });

    test('app depends on db with healthcheck condition', () => {
      expect(compose.services.app.depends_on.db.condition).toBe('service_healthy');
    });

    test('db service uses postgres:15-alpine image', () => {
      expect(compose.services.db.image).toBe('postgres:15-alpine');
    });

    test('db has healthcheck configured', () => {
      expect(compose.services.db.healthcheck).toBeDefined();
      expect(compose.services.db.healthcheck.test).toContain('pg_isready');
      expect(compose.services.db.healthcheck.interval).toBe('5s');
    });

    test('volumes are configured for data persistence', () => {
      expect(compose.volumes.postgres_data).toBeDefined();
      expect(compose.volumes.uploads).toBeDefined();
    });

    test('custom network is defined', () => {
      expect(compose.networks['agri-network']).toBeDefined();
      expect(compose.networks['agri-network'].driver).toBe('bridge');
    });

    test('environment variables use proper defaults', () => {
      const appEnv = compose.services.app.environment;
      const dbEnv = compose.services.db.environment;
      
      // Check that DB_HOST is set to 'db' for Docker networking
      const dbHostVar = appEnv.find(e => typeof e === 'string' && e.startsWith('DB_HOST='));
      expect(dbHostVar).toBe('DB_HOST=db');
      
      // Check PostgreSQL defaults
      expect(dbEnv).toContain('POSTGRES_DB=${DB_NAME:-agriconnect}');
    });

    test('app service has restart policy', () => {
      expect(compose.services.app.restart).toBe('unless-stopped');
    });

    test('db service mounts initialization scripts', () => {
      const volumes = compose.services.db.volumes;
      const initMount = volumes.find(v => v.includes('docker-entrypoint-initdb.d'));
      expect(initMount).toBeDefined();
    });
  });

  describe('Healthcheck Script', () => {
    beforeEach(() => {
      jest.resetModules();
      delete require.cache[require.resolve('../healthcheck.js')];
    });

    afterEach(() => {
      delete process.env.PORT;
    });

    test('makes HTTP request to /health endpoint', () => {
      const mockRequest = {
        on: jest.fn().mockReturnThis(),
        end: jest.fn()
      };
      
      let capturedOptions;
      http.request = jest.fn((options, callback) => {
        capturedOptions = options;
        callback({ statusCode: 200 });
        return mockRequest;
      });

      jest.spyOn(process, 'exit').mockImplementation(() => {});
      
      require('../healthcheck.js');
      
      expect(capturedOptions.path).toBe('/health');
      expect(capturedOptions.method).toBe('GET');
      expect(capturedOptions.host).toBe('localhost');
      expect(capturedOptions.timeout).toBe(2000);
    });

    test('exits with code 0 on successful health check', () => {
      const mockExit = jest.spyOn(process, 'exit').mockImplementation(() => {});
      
      http.request = jest.fn((options, callback) => {
        callback({ statusCode: 200 });
        return { on: jest.fn().mockReturnThis(), end: jest.fn() };
      });

      require('../healthcheck.js');
      
      expect(mockExit).toHaveBeenCalledWith(0);
    });

    test('exits with code 1 on failed health check (non-200 status)', () => {
      const mockExit = jest.spyOn(process, 'exit').mockImplementation(() => {});
      
      http.request = jest.fn((options, callback) => {
        callback({ statusCode: 503 });
        return { on: jest.fn().mockReturnThis(), end: jest.fn() };
      });

      require('../healthcheck.js');
      
      expect(mockExit).toHaveBeenCalledWith(1);
    });

    test('exits with code 1 on request error', () => {
      const mockExit = jest.spyOn(process, 'exit').mockImplementation(() => {});
      const mockRequest = {
        on: jest.fn((event, handler) => {
          if (event === 'error') handler(new Error('Connection refused'));
          return mockRequest;
        }),
        end: jest.fn()
      };
      
      http.request = jest.fn(() => mockRequest);

      require('../healthcheck.js');
      
      expect(mockExit).toHaveBeenCalledWith(1);
    });

    test('exits with code 1 on request timeout', () => {
      const mockExit = jest.spyOn(process, 'exit').mockImplementation(() => {});
      const mockDestroy = jest.fn();
      const mockRequest = {
        on: jest.fn((event, handler) => {
          if (event === 'timeout') {
            handler();
          }
          return mockRequest;
        }),
        destroy: mockDestroy,
        end: jest.fn()
      };
      
      http.request = jest.fn(() => mockRequest);

      require('../healthcheck.js');
      
      expect(mockDestroy).toHaveBeenCalled();
      expect(mockExit).toHaveBeenCalledWith(1);
    });

    test('uses PORT environment variable when set', () => {
      process.env.PORT = '8080';
      let capturedOptions;
      
      http.request = jest.fn((options, callback) => {
        capturedOptions = options;
        callback({ statusCode: 200 });
        return { on: jest.fn().mockReturnThis(), end: jest.fn() };
      });
      
      jest.spyOn(process, 'exit').mockImplementation(() => {});

      require('../healthcheck.js');
      
      expect(capturedOptions.port).toBe('8080');
    });

    test('defaults to port 3000 when PORT not set', () => {
      let capturedOptions;
      
      http.request = jest.fn((options, callback) => {
        capturedOptions = options;
        callback({ statusCode: 200 });
        return { on: jest.fn().mockReturnThis(), end: jest.fn() };
      });
      
      jest.spyOn(process, 'exit').mockImplementation(() => {});

      require('../healthcheck.js');
      
      expect(capturedOptions.port).toBe(3000);
    });
  });

  describe('Database Initialization', () => {
    let sqlContent;
    
    beforeAll(() => {
      sqlContent = fs.readFileSync(
        path.join(rootDir, 'docker-entrypoint-initdb.d/init.sql'), 
        'utf8'
      );
    });

    test('creates users table with required columns', () => {
      expect(sqlContent).toMatch(/CREATE TABLE IF NOT EXISTS users/i);
      expect(sqlContent).toContain('id SERIAL PRIMARY KEY');
      expect(sqlContent).toContain('email VARCHAR(255) UNIQUE NOT NULL');
      expect(sqlContent).toContain('password_hash VARCHAR(255) NOT NULL');
      expect(sqlContent).toContain('role VARCHAR(50)');
    });

    test('creates products table with foreign key to users', () => {
      expect(sqlContent).toMatch(/CREATE TABLE IF NOT EXISTS products/i);
      expect(sqlContent).toContain('farmer_id INTEGER REFERENCES users(id) ON DELETE CASCADE');
      expect(sqlContent).toContain('price DECIMAL(10, 2)');
    });

    test('creates indexes for performance optimization', () => {
      expect(sqlContent).toMatch(/CREATE INDEX IF NOT EXISTS idx_users_email/i);
      expect(sqlContent).toMatch(/CREATE INDEX IF NOT EXISTS idx_products_farmer/i);
      expect(sqlContent).toMatch(/CREATE INDEX IF NOT EXISTS idx_products_category/i);
    });

    test('includes timestamps on tables', () => {
      expect(sqlContent).toContain('created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP');
      expect(sqlContent).toContain('updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP');
    });
  });

  describe('Environment Configuration', () => {
    let envContent;
    
    beforeAll(() => {
      envContent = fs.readFileSync(path.join(rootDir, '.env.example'), 'utf8');
    });

    test('contains all required database variables', () => {
      expect(envContent).toContain('DB_HOST=');
      expect(envContent).toContain('DB_PORT=');
      expect(envContent).toContain('DB_NAME=');
      expect(envContent).toContain('DB_USER=');
      expect(envContent).toContain('DB_PASSWORD=');
    });

    test('contains JWT secret configuration', () => {
      expect(envContent).toContain('JWT_SECRET=');
    });

    test('documents Docker-specific configuration', () => {
      expect(envContent).toContain('DB_HOST=db');
      expect(envContent).toContain('When running in Docker');
    });

    test('has NODE_ENV configuration', () => {
      expect(envContent).toContain('NODE_ENV=');
    });

    test('has PORT configuration', () => {
      expect(envContent).toContain('PORT=');
    });
  });

  describe('Docker Ignore', () => {
    let ignoreContent;
    
    beforeAll(() => {
      ignoreContent = fs.readFileSync(path.join(rootDir, '.dockerignore'), 'utf8');
    });

    test('excludes node_modules', () => {
      expect(ignoreContent).toContain('node_modules');
    });

    test('excludes environment files', () => {
      expect(ignoreContent).toContain('.env');
      expect(ignoreContent).toContain('.env.local');
      expect(ignoreContent).toContain('.env.development');
    });

    test('excludes git directory', () => {
      expect(ignoreContent).toContain('.git');
    });

    test('excludes build artifacts', () => {
      expect(ignoreContent).toContain('dist');
      expect(ignoreContent).toContain('build');
    });

    test('excludes log files', () => {
      expect(ignoreContent).toContain('*.log');
      expect(ignoreContent).toContain('logs');
    });

    test('excludes Docker files themselves', () => {
      expect(ignoreContent).toContain('Dockerfile');
      expect(ignoreContent).toContain('.dockerignore');
    });
  });
});

// Integration tests - these require Docker to be running
describe('Docker Integration Tests', () => {
  test('docker-compose.yml is valid', () => {
    try {
      execSync('docker-compose config', { 
        cwd: path.join(__dirname, '..'),
        stdio: 'pipe'
      });
    } catch (error) {
      throw new Error(`docker-compose.yml validation failed: ${error.stderr?.toString() || error.message}`);
    }
  }, 30000);

  test('Dockerfile can be built', () => {
    // Skip if RUN_DOCKER_TESTS is not set to avoid slow tests in unit test runs
    if (!process.env.RUN_DOCKER_TESTS) {
      return;
    }

    try {
      execSync('docker build -t agri-connect-test .', {
        cwd: path.join(__dirname, '..'),
        stdio: 'pipe'
      });
    } catch (error) {
      throw new Error(`Docker build failed: ${error.stderr?.toString() || error.message}`);
    }
  }, 120000); // 2 minute timeout for build
});