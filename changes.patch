import pytest
import re
import os
from pathlib import Path

class TestReadmeStructure:
    """Tests to validate README.md structure and content"""
    
    @pytest.fixture(scope="class")
    def readme_content(self):
        """Fixture to load README.md content"""
        readme_path = Path("README.md")
        if not readme_path.exists():
            pytest.skip("README.md not found")
        return readme_path.read_text(encoding="utf-8")
    
    def test_readme_file_exists(self):
        """Test that README.md file exists in repository root"""
        assert Path("README.md").exists(), "README.md file should exist"
    
    def test_readme_not_empty(self, readme_content):
        """Test that README.md is not empty"""
        assert len(readme_content.strip()) > 0, "README.md should not be empty"
    
    def test_title_present(self, readme_content):
        """Test that project title is present"""
        assert "# Agri-Connect" in readme_content or "# agri-connect" in readme_content, \
            "Project title should be present"
    
    def test_description_present(self, readme_content):
        """Test that project description is present"""
        assert "> A comprehensive" in readme_content or "Overview" in readme_content, \
            "Project description or overview section should be present"
    
    def test_key_features_section(self, readme_content):
        """Test that Key Features section exists with bullet points"""
        assert "## ✨ Key Features" in readme_content or "## Key Features" in readme_content, \
            "Key Features section should be present"
        # Check for feature bullet points
        feature_patterns = [
            r"-\s+\*\*.*\*\*.*",  # Markdown bold bullet points
            r"-\s+.*Crop.*",
            r"-\s+.*Price.*",
            r"-\s+.*Farmer.*"
        ]
        found_features = sum(1 for pattern in feature_patterns if re.search(pattern, readme_content))
        assert found_features >= 2, "Should have at least 2 feature bullet points"
    
    def test_tech_stack_section(self, readme_content):
        """Test that Tech Stack section is present"""
        assert "## 🛠️ Tech Stack" in readme_content or "## Tech Stack" in readme_content, \
            "Tech Stack section should be present"
        # Check for common technologies
        tech_keywords = ["React", "Node.js", "MongoDB", "Express"]
        found_tech = sum(1 for tech in tech_keywords if tech in readme_content)
        assert found_tech >= 2, "Should mention at least 2 technologies"
    
    def test_installation_section(self, readme_content):
        """Test that Installation section with prerequisites exists"""
        assert "## 🚀 Installation" in readme_content or "## Installation" in readme_content, \
            "Installation section should be present"
        assert "Prerequisites" in readme_content, \
            "Prerequisites subsection should be present"
    
    def test_installation_code_blocks(self, readme_content):
        """Test that installation instructions include code blocks"""
        # Check for bash code blocks
        bash_blocks = re.findall(r"```bash\n[\s\S]*?```", readme_content)
        assert len(bash_blocks) >= 2, "Should have at least 2 bash code blocks for installation"
    
    def test_environment_variables_documented(self, readme_content):
        """Test that environment variables are documented"""
        assert ".env" in readme_content, "Should mention .env file configuration"
        env_vars = ["PORT", "MONGODB_URI", "JWT_SECRET"]
        found_vars = sum(1 for var in env_vars if var in readme_content)
        assert found_vars >= 2, "Should document at least 2 environment variables"
    
    def test_usage_section(self, readme_content):
        """Test that Usage section exists with examples"""
        assert "## 📖 Usage" in readme_content or "## Usage" in readme_content, \
            "Usage section should be present"
    
    def test_api_documentation_section(self, readme_content):
        """Test that API Documentation section exists"""
        assert "## 📚 API Documentation" in readme_content or "## API Documentation" in readme_content, \
            "API Documentation section should be present"
    
    def test_api_example_code_block(self, readme_content):
        """Test that API examples include code blocks"""
        # Check for javascript or json code blocks
        code_blocks = re.findall(r"```(javascript|json|js)\n[\s\S]*?```", readme_content)
        assert len(code_blocks) >= 1, "Should have at least 1 code block for API examples"
    
    def test_contributing_section(self, readme_content):
        """Test that Contributing section exists"""
        assert "## 🤝 Contributing" in readme_content or "## Contributing" in readme_content, \
            "Contributing section should be present"
    
    def test_license_section(self, readme_content):
        """Test that License section exists"""
        assert "## 📄 License" in readme_content or "## License" in readme_content, \
            "License section should be present"
        assert "MIT" in readme_content or "LICENSE" in readme_content, \
            "Should mention license type or LICENSE file"
    
    def test_contact_section(self, readme_content):
        """Test that Contact section exists"""
        assert "## 📞 Contact" in readme_content or "## Contact" in readme_content, \
            "Contact section should be present"
    
    def test_badges_present(self, readme_content):
        """Test that status badges are present"""
        badge_patterns = [
            r"\[\!\[Build Status\]",
            r"\[\!\[License\]",
            r"\[\!\[Version\]"
        ]
        found_badges = sum(1 for pattern in badge_patterns if re.search(pattern, readme_content))
        assert found_badges >= 2, "Should have at least 2 status badges"
    
    def test_markdown_links_valid_format(self, readme_content):
        """Test that markdown links are properly formatted"""
        # Find all markdown links [text](url)
        links = re.findall(r"\[([^\]]+)\]\(([^)]+)\)", readme_content)
        assert len(links) > 0, "Should have at least one markdown link"
        
        for text, url in links:
            assert text.strip(), "Link text should not be empty"
            assert url.strip(), "Link URL should not be empty"
            if url.startswith("http"):
                assert not url.endswith(" "), "URL should not end with space"
    
    def test_headings_hierarchy(self, readme_content):
        """Test that headings follow proper hierarchy"""
        lines = readme_content.split('\n')
        for i, line in enumerate(lines):
            if line.startswith('#') and not line.startswith('# '):
                # Check that single # is followed by space (H1)
                if line.startswith('##') and not line.startswith('## '):
                    # Check H2
                    pass
        
        # Check that H1 exists (title)
        h1_count = len(re.findall(r"^# [^#]", readme_content, re.MULTILINE))
        assert h1_count >= 1, "Should have at least one H1 heading"
    
    def test_no_placeholder_text(self, readme_content):
        """Test that no obvious placeholder text remains"""
        placeholders = ["your_api_key", "your_cloud_name", "your_jwt_secret", "example.com"]
        # Allow example.com in contact email as it's common
        critical_placeholders = ["your_api_key", "your_cloud_name", "your_jwt_secret"]
        
        for placeholder in critical_placeholders:
            if placeholder in readme_content:
                # Check if it's in a code block (which is acceptable for examples)
                pass  # Placeholders in code blocks are instructional


class TestReadmeLinks:
    """Tests for validating links in README (optional - requires network)"""
    
    @pytest.fixture(scope="class")
    def readme_content(self):
        """Fixture to load README.md content"""
        readme_path = Path("README.md")
        if not readme_path.exists():
            pytest.skip("README.md not found")
        return readme_path.read_text(encoding="utf-8")
    
    @pytest.mark.skip(reason="Network dependent - run manually")
    def test_external_links_reachable(self, readme_content):
        """Test that external links are reachable (requires network)"""
        import urllib.request
        from urllib.error import HTTPError, URLError
        
        # Extract URLs
        urls = re.findall(r"https?://[^\s\)\"]+", readme_content)
        
        failed_urls = []
        for url in urls[:5]:  # Test first 5 to avoid rate limiting
            try:
                req = urllib.request.Request(url, method='HEAD')
                urllib.request.urlopen(req, timeout=5)
            except (HTTPError, URLError) as e:
                failed_urls.append((url, str(e)))
        
        assert len(failed_urls) == 0, f"Failed URLs: {failed_urls}"
    
    def test_internal_links_references(self, readme_content):
        """Test that internal file references exist"""
        # Find references to internal files like LICENSE, CONTRIBUTING.md
        internal_refs = re.findall(r"\[([^\]]+)\]\(([^http][^)]+)\)", readme_content)
        
        for text, ref in internal_refs:
            if ref.startswith("#"):
                continue  # Anchor links
            if "." in ref and not ref.endswith(".md"):
                continue  # Likely a file with extension
            
            # Check if referenced file exists (optional)
            if ref in ["LICENSE", "CONTRIBUTING.md", "CODE_OF_CONDUCT.md"]:
                # These are standard files that may or may not exist yet
                pass


class TestReadmeContentQuality:
    """Tests for content quality and completeness"""
    
    @pytest.fixture(scope="class")
    def readme_content(self):
        """Fixture to load README.md content"""
        readme_path = Path("README.md")
        if not readme_path.exists():
            pytest.skip("README.md not found")
        return readme_path.read_text(encoding="utf-8")
    
    def test_minimum_content_length(self, readme_content):
        """Test that README has substantial content"""
        lines = readme_content.split('\n')
        non_empty_lines = [line for line in lines if line.strip()]
        assert len(non_empty_lines) >= 20, "README should have at least 20 non-empty lines"
    
    def test_contains_emojis_for_readability(self, readme_content):
        """Test that emojis are used for better readability (optional)"""
        # Check for common section emojis
        emojis = ["🌾", "🌱", "✨", "🛠️", "🚀", "📖", "📚", "🤝", "📄", "📞"]
        found_emojis = sum(1 for emoji in emojis if emoji in readme_content)
        assert found_emojis >= 3, "Should use emojis for better visual organization"
    
    def test_installation_steps_numbered_or_bulleted(self, readme_content):
        """Test that installation steps are properly numbered"""
        numbered_steps = re.findall(r"^\d+\.", readme_content, re.MULTILINE)
        assert len(numbered_steps) >= 3, "Should have at least 3 numbered installation steps"
    
    def test_code_blocks_specify_language(self, readme_content):
        """Test that code blocks specify the language"""
        code_blocks = re.findall(r"```(\w+)?\n", readme_content)
        specified_languages = [block for block in code_blocks if block]
        assert len(specified_languages) >= len(code_blocks) * 0.5, \
            "At least 50% of code blocks should specify language"
    
    def test_no_trailing_whitespace(self, readme_content):
        """Test that lines don't have trailing whitespace"""
        lines_with_trailing = [i for i, line in enumerate(readme_content.split('\n'), 1) 
                              if line.endswith(' ') and line.strip()]
        # Allow some flexibility, but should be minimal
        assert len(lines_with_trailing) < 10, \
            f"Found {len(lines_with_trailing)} lines with trailing whitespace"


# Integration test to verify README renders correctly
class TestReadmeIntegration:
    """Integration tests for README validation"""
    
    def test_readme_can_be_parsed(self):
        """Test that README can be parsed as markdown"""
        try:
            import markdown
            readme_path = Path("README.md")
            if not readme_path.exists():
                pytest.skip("README.md not found")
            
            content = readme_path.read_text(encoding="utf-8")
            html = markdown.markdown(content)
            assert html, "README should convert to HTML"
            assert "<h1>" in html or "<h2>" in html, "Should have HTML headings"
        except ImportError:
            pytest.skip("markdown library not installed")
    
    def test_readme_sections_order(self):
        """Test that sections appear in logical order"""
        readme_path = Path("README.md")
        if not readme_path.exists():
            pytest.skip("README.md not found")
        
        content = readme_path.read_text(encoding="utf-8")
        
        # Define expected order of major sections
        sections = [
            ("Installation", "Usage"),
            ("Usage", "API Documentation"),
            ("API Documentation", "Contributing"),
            ("Contributing", "License"),
            ("License", "Contact")
        ]
        
        for first, second in sections:
            first_pos = content.find(f"## {first}") or content.find(f"## ")
            second_pos = content.find(f"## {second}")
            
            if first_pos > -1 and second_pos > -1:
                assert first_pos < second_pos, \
                    f"{first} section should come before {second}"


