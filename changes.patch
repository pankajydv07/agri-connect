import pytest
import os
import re
from pathlib import Path

class TestReadmeStructure:
    """Tests for README.md structure and content validation."""
    
    @pytest.fixture(scope="class")
    def readme_content(self):
        """Fixture to load README.md content."""
        readme_path = Path("README.md")
        if not readme_path.exists():
            pytest.skip("README.md not found")
        return readme_path.read_text(encoding="utf-8")
    
    def test_readme_file_exists(self):
        """Verify that README.md exists in the repository root."""
        assert Path("README.md").exists(), "README.md file should exist"
    
    def test_readme_not_empty(self, readme_content):
        """Verify README.md is not empty."""
        assert len(readme_content) > 0, "README.md should not be empty"
        assert len(readme_content) > 1000, "README.md should contain substantial content"
    
    def test_title_present(self, readme_content):
        """Verify main title is present."""
        assert "# 🌾 Agri-Connect" in readme_content, "Main title should be present"
    
    def test_required_sections_present(self, readme_content):
        """Verify all required documentation sections exist."""
        required_sections = [
            "## 📋 Table of Contents",
            "## 🌱 About",
            "## ✨ Features",
            "## 🛠 Tech Stack",
            "## 🚀 Installation",
            "## 🔧 Environment Variables",
            "## 📖 Usage",
            "## 📚 API Documentation",
            "## 🤝 Contributing",
            "## 📄 License",
            "## 📞 Contact & Support"
        ]
        
        for section in required_sections:
            assert section in readme_content, f"Required section '{section}' should be present"
    
    def test_badges_present(self, readme_content):
        """Verify status badges are included."""
        badge_patterns = [
            r"\[!\[Build Status\]",
            r"\[!\[License\]",
            r"\[!\[Version\]",
            r"\[!\[Node\.js\]",
            r"\[!\[React\]"
        ]
        
        for pattern in badge_patterns:
            assert re.search(pattern, readme_content), f"Badge pattern '{pattern}' should be present"
    
    def test_installation_instructions_complete(self, readme_content):
        """Verify installation section contains necessary steps."""
        installation_section = readme_content.split("## 🚀 Installation")[1].split("##")[0]
        
        required_steps = [
            "git clone",
            "npm install",
            "cp .env.example",
            "npm run dev",
            "npm start"
        ]
        
        for step in required_steps:
            assert step in installation_section, f"Installation step '{step}' should be documented"
    
    def test_environment_variables_documented(self, readme_content):
        """Verify environment variables section contains examples."""
        env_section = readme_content.split("## 🔧 Environment Variables")[1].split("##")[0]
        
        required_env_vars = [
            "NODE_ENV",
            "MONGODB_URI",
            "JWT_SECRET",
            "CLOUDINARY",
            "WEATHER_API_KEY"
        ]
        
        for var in required_env_vars:
            assert var in env_section, f"Environment variable '{var}' should be documented"
    
    def test_api_endpoints_documented(self, readme_content):
        """Verify API documentation section contains endpoint tables."""
        api_section = readme_content.split("## 📚 API Documentation")[1].split("##")[0]
        
        # Check for endpoint categories
        assert "Authentication Endpoints" in api_section
        assert "Marketplace Endpoints" in api_section
        assert "Messaging Endpoints" in api_section
        assert "Equipment Endpoints" in api_section
        
        # Check for HTTP methods
        http_methods = ["POST", "GET", "PUT", "DELETE"]
        for method in http_methods:
            assert f"| {method} |" in api_section, f"HTTP method '{method}' should be documented"
    
    def test_code_blocks_syntax(self, readme_content):
        """Verify code blocks are properly formatted."""
        # Check for bash code blocks
        assert "```bash" in readme_content
        assert "```env" in readme_content
        
        # Verify code blocks are closed
        open_blocks = readme_content.count("```")
        assert open_blocks % 2 == 0, "All code blocks should be properly closed"
    
    def test_contributing_guidelines_complete(self, readme_content):
        """Verify contributing section has required guidelines."""
        contrib_section = readme_content.split("## 🤝 Contributing")[1].split("##")[0]
        
        required_items = [
            "Fork the repository",
            "git checkout -b",
            "git commit",
            "git push",
            "Pull Request",
            "feature/",
            "bugfix/",
            "Conventional Commits"
        ]
        
        for item in required_items:
            assert item in contrib_section, f"Contributing guideline '{item}' should be present"
    
    def test_license_section_complete(self, readme_content):
        """Verify license section contains MIT license text."""
        license_section = readme_content.split("## 📄 License")[1].split("##")[0]
        
        assert "MIT License" in license_section
        assert "Copyright" in license_section
        assert "Permission is hereby granted" in license_section
    
    def test_contact_information_present(self, readme_content):
        """Verify contact section has maintainer info."""
        contact_section = readme_content.split("## 📞 Contact & Support")[1]
        
        assert "Pankaj Yadav" in contact_section
        assert "@pankajydv07" in contact_section
        assert "support@agri-connect.com" in contact_section
    
    def test_markdown_headers_hierarchy(self, readme_content):
        """Verify markdown headers follow proper hierarchy (no skipping levels)."""
        lines = readme_content.split('\n')
        header_levels = []
        
        for line in lines:
            if line.startswith('#'):
                level = len(line) - len(line.lstrip('#'))
                header_levels.append(level)
        
        # Check that we don't skip from h1 to h3, etc.
        for i in range(1, len(header_levels)):
            assert header_levels[i] <= header_levels[i-1] + 1, \
                f"Header hierarchy violation: h{header_levels[i-1]} followed by h{header_levels[i]}"
    
    def test_no_broken_internal_links(self, readme_content):
        """Verify internal markdown links reference existing sections."""
        # Extract all markdown links
        link_pattern = r'\[([^\]]+)\]\(([^)]+)\)'
        links = re.findall(link_pattern, readme_content)
        
        # Check internal anchors (starting with #)
        for text, url in links:
            if url.startswith('#') and not url.startswith('#-'):
                # Convert anchor to expected header format
                anchor = url[1:].lower().replace('-', ' ')
                # Check if corresponding header exists
                header_pattern = f"## {anchor.title()}"
                assert header_pattern in readme_content or anchor in readme_content.lower(), \
                    f"Internal link '{url}' may be broken"
    
    def test_images_have_alt_text(self, readme_content):
        """Verify all images have alt text for accessibility."""
        # Pattern for images without alt text: ![](url)
        bad_image_pattern = r'!\[\]\([^\)]+\)'
        bad_images = re.findall(bad_image_pattern, readme_content)
        assert len(bad_images) == 0, f"Images should have alt text: {bad_images}"


class TestReadmeContentQuality:
    """Tests for README content quality and completeness."""
    
    @pytest.fixture(scope="class")
    def readme_content(self):
        """Fixture to load README.md content."""
        readme_path = Path("README.md")
        if not readme_path.exists():
            pytest.skip("README.md not found")
        return readme_path.read_text(encoding="utf-8")
    
    def test_features_section_detailed(self, readme_content):
        """Verify features section has detailed descriptions."""
        features_section = readme_content.split("## ✨ Features")[1].split("##")[0]
        
        # Check for feature categories
        feature_categories = [
            "User Management",
            "Marketplace", 
            "Communication",
            "Equipment Sharing",
            "Analytics & Insights"
        ]
        
        for category in feature_categories:
            assert category in features_section, f"Feature category '{category}' should be documented"
    
    def test_tech_stack_specifies_versions(self, readme_content):
        """Verify tech stack includes version numbers where applicable."""
        tech_section = readme_content.split("## 🛠 Tech Stack")[1].split("##")[0]
        
        version_patterns = [
            r"React\.js.*v18",
            r"Node\.js.*v14",
            r"MongoDB.*v4\.4"
        ]
        
        for pattern in version_patterns:
            assert re.search(pattern, tech_section), f"Version info for pattern '{pattern}' should be specified"
    
    def test_usage_examples_for_all_roles(self, readme_content):
        """Verify usage section covers all user roles."""
        usage_section = readme_content.split("## 📖 Usage")[1].split("##")[0]
        
        user_roles = ["Farmers", "Buyers", "Experts"]
        for role in user_roles:
            assert f"### For {role}" in usage_section, f"Usage instructions for '{role}' should be present"
    
    def test_prerequisites_listed(self, readme_content):
        """Verify prerequisites are clearly listed."""
        install_section = readme_content.split("## 🚀 Installation")[1]
        prereq_subsection = install_section.split("### Prerequisites")[1].split("###")[0]
        
        prerequisites = ["Node.js", "npm", "MongoDB", "Git"]
        for prereq in prerequisites:
            assert prereq in prereq_subsection, f"Prerequisite '{prereq}' should be listed"


class TestReadmeIntegration:
    """Integration tests for README validation with actual repository."""
    
    def test_documented_scripts_exist(self):
        """Verify that npm scripts mentioned in README exist in package.json."""
        readme_path = Path("README.md")
        package_path = Path("package.json")
        
        if not readme_path.exists() or not package_path.exists():
            pytest.skip("Required files not found")
        
        readme_content = readme_path.read_text()
        package_content = package_path.read_text()
        
        # Extract npm run commands from README
        npm_pattern = r'npm run (\w+)'
        documented_scripts = set(re.findall(npm_pattern, readme_content))
        
        # Check if mentioned scripts exist (basic check)
        for script in documented_scripts:
            if script in ["dev", "start", "migrate", "seed"]:
                # These are standard scripts, verify they are mentioned in package.json context
                assert f'"{script}"' in package_content or script in package_content, \
                    f"Script '{script}' documented in README should exist in package.json"
    
    def test_env_example_exists(self):
        """Verify that .env.example is referenced and should exist."""
        readme_path = Path("README.md")
        if not readme_path.exists():
            pytest.skip("README.md not found")
        
        readme_content = readme_path.read_text()
        
        if ".env.example" in readme_content:
            env_example = Path(".env.example")
            backend_env = Path("backend/.env.example")
            
            assert env_example.exists() or backend_env.exists(), \
                ".env.example should exist since it's referenced in README"


if __name__ == "__main__":
    pytest.main([__file__, "-v"])