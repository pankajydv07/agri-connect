    def test_no_trailing_whitespace(self, env_content):
        """Test file has no trailing whitespace (code quality)"""
        lines = env_content.splitlines()
        for i, line in enumerate(lines, 1):
            if line != line.rstrip():
                assert False, f"Line {i} has trailing whitespace"

    def test_file_ends_with_newline(self, env_content):
        """Test file ends with newline (POSIX standard)"""
        if env_content:
            assert env_content.endswith('\n'), "File should end with newline"

    def test_no_duplicate_variables(self, parsed_vars, env_content):
        """Test that no variable is defined twice"""
        lines = env_content.splitlines()
        seen = set()
        for line in lines:
            if '=' in line and not line.strip().startswith('#'):
                key = line.split('=', 1)[0].strip()
                if key in seen:
                    assert False, f"Variable {key} is defined multiple times"
                seen.add(key)