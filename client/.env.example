# ---------------------------------------------------------------------------
# Agri-Connect — client environment variables
#
# Copy this file to .env.local and fill in the values for your environment.
# DO NOT commit .env.local or any real .env file to version control.
#
# WARNING: Create React App (CRA) inlines every REACT_APP_* variable into the
# compiled JavaScript bundle at build time.  The bundle is shipped to every
# visitor's browser and is trivially readable.  NEVER place any secret
# (API keys, passwords, tokens) in a REACT_APP_* variable.
#
# All AI provider keys (OpenAI, etc.) now live server-side only.  They are
# read from the server's own environment (e.g. server/.env) and are never
# exposed to the client.
# ---------------------------------------------------------------------------

# Base URL of the backend API server.
# In production, replace with your deployed server URL (no trailing slash).
REACT_APP_API_URL=http://localhost:5000
