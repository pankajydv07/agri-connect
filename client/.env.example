# React App Configuration
# The port for React development server (optional)
PORT=3000

# API Configuration
# Base URL for backend API endpoints
# Use http://localhost:5000/api for local development
# Use your production API URL for deployment
REACT_APP_API_URL=http://localhost:5000/api

# OpenAI API
# Required if using OpenAI features directly from the client
# Note: Exposing API keys in client-side code is not recommended for production
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here

# Google OAuth
# Client ID for Google Sign-In (if using Google authentication)
