# Client-side environment variables
# Note: All variables must start with REACT_APP_ to be accessible in React

# API URL for backend server
REACT_APP_API_URL=http://localhost:5000

# Environment
REACT_APP_ENV=development

# Optional: Google Cloud API Key (if using client-side speech recognition)
# REACT_APP_GOOGLE_CLOUD_API_KEY=your_google_api_key_here
