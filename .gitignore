# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing
coverage/

# Production builds
build/
dist/

# ---------------------------------------------------------------------------
# Secrets
#
# This repository previously had a Google Cloud service-account private key
# committed in two places (server/google-credentials.json and server/key.json).
# These patterns exist so that cannot happen again — credentials belong in
# environment variables, never in the working tree.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
google-credentials.json
key.json
service-account*.json
gcp-*.json
credentials.json
secrets.json

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors and OS
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Local uploads (images now stream to Cloudinary; generated audio goes to tmp)
uploads/
!uploads/.gitkeep

# Misc
.cache
*.tsbuildinfo
